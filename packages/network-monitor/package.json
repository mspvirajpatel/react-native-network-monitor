{
  "name": "@mspvirajpatel/react-native-network-monitor",
  "version": "0.3.0",
  "description": "A powerful, production-ready debug monitor for React Native apps. Intercepts network requests (fetch & XHR), captures console logs, and provides a beautiful in-app debug UI with password protection, environment switching, and log export.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "network-monitor",
    "debug",
    "debugger",
    "network",
    "interceptor",
    "fetch",
    "xhr",
    "console",
    "logger",
    "debug-monitor",
    "react-native-debug",
    "network-inspector",
    "api-monitor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mspvirajpatel/react-native-network-monitor.git"
  },
  "author": "Viraj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mspvirajpatel/react-native-network-monitor/issues"
  },
  "homepage": "https://github.com/mspvirajpatel/react-native-network-monitor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-safe-area-context": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-safe-area-context": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": false
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
